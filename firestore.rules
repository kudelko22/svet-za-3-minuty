rules_version = '2';
// Svet za 3 minúty: každý prihlásený rodič vidí a mení len svoju rodinu.
service cloud.firestore {
  match /databases/{database}/documents {

    function jeMoj(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Postavička: len známe kľúče a krátke hodnoty z písmen, číslic a #. Hodnoty sa pri priateľoch vykresľujú do SVG, preto nesmú obsahovať iné znaky.
    function platnyAvatar(a) {
      return a is map
        && a.keys().hasOnly(['vlasy', 'farbaVlasov', 'koza', 'oci', 'usta', 'okuliare', 'tricko', 'vzor', 'doplnok', 'zvieratko', 'kuzlo', 'pozadie'])
        && a.size() <= 12
        && a.get('vlasy', 'x') is string && a.get('vlasy', 'x').size() <= 14 && a.get('vlasy', 'x').matches('^[#A-Za-z0-9]+$')
        && a.get('farbaVlasov', '#000000') is string && a.get('farbaVlasov', '#000000').matches('^#[0-9A-Fa-f]{6}$')
        && a.get('koza', '#000000') is string && a.get('koza', '#000000').matches('^#[0-9A-Fa-f]{6}$')
        && a.get('tricko', '#000000') is string && a.get('tricko', '#000000').matches('^#[0-9A-Fa-f]{6}$')
        && a.get('pozadie', '#000000') is string && a.get('pozadie', '#000000').matches('^#[0-9A-Fa-f]{6}$')
        && a.get('oci', 'x') is string && a.get('oci', 'x').size() <= 14 && a.get('oci', 'x').matches('^[#A-Za-z0-9]+$')
        && a.get('usta', 'x') is string && a.get('usta', 'x').size() <= 14 && a.get('usta', 'x').matches('^[#A-Za-z0-9]+$')
        && a.get('okuliare', 'x') is string && a.get('okuliare', 'x').size() <= 14 && a.get('okuliare', 'x').matches('^[#A-Za-z0-9]+$')
        && a.get('vzor', 'x') is string && a.get('vzor', 'x').size() <= 14 && a.get('vzor', 'x').matches('^[#A-Za-z0-9]+$')
        && a.get('doplnok', 'x') is string && a.get('doplnok', 'x').size() <= 14 && a.get('doplnok', 'x').matches('^[#A-Za-z0-9]+$')
        && a.get('zvieratko', 'x') is string && a.get('zvieratko', 'x').size() <= 14 && a.get('zvieratko', 'x').matches('^[#A-Za-z0-9]+$')
        && a.get('kuzlo', 'x') is string && a.get('kuzlo', 'x').size() <= 14 && a.get('kuzlo', 'x').matches('^[#A-Za-z0-9]+$');
    }

    // Profil dieťaťa: meno, vek, postavička, pokrok a odznaky (od verzie 6; odznaky a zvieratko od verzie 8, kedy a chyby od verzie 11, vybrate od verzie 19)
    function platneDieta(d) {
      return d.keys().hasOnly(['meno', 'vek', 'avatar', 'body', 'done', 'fav', 'dni', 'odznaky', 'kedy', 'chyby', 'vybrate', 'poradie', 'verzia', 'upravene'])
        && d.meno is string && d.meno.size() >= 1 && d.meno.size() <= 20
        && d.vek in ['mladsi', 'starsi']
        && platnyAvatar(d.avatar)
        && (!('odznaky' in d) || (d.odznaky is list && d.odznaky.size() <= 100))
        && (!('kedy' in d) || (d.kedy is map && d.kedy.size() <= 500))
        && (!('chyby' in d) || (d.chyby is list && d.chyby.size() <= 60))
        && (!('vybrate' in d) || (d.vybrate is list && d.vybrate.size() <= 100))
        && d.body is int && d.body >= 0 && d.body <= 1000000
        && d.done is list && d.done.size() <= 500
        && d.fav is list && d.fav.size() <= 500
        && d.dni is list && d.dni.size() <= 400
        && d.poradie is int && d.poradie >= 0 && d.poradie <= 10000000000000 && d.verzia is int && d.verzia >= 0 && d.verzia <= 1000
        && d.upravene == request.time;
    }

    match /rodiny/{uid}/deti/{dieta} {
      allow read, delete: if jeMoj(uid);
      allow create, update: if jeMoj(uid) && dieta.matches('^[a-z0-9]{6,32}$') && platneDieta(request.resource.data);
    }

    // ---- Profil rodiča (verzia 3.5): jeden na rodinu, PIN len ako PBKDF2 hash; nikdy sa nezverejňuje (nie je v profily, kody ani správach) ----
    function platnyRodic(d) {
      return d.keys().hasOnly(['meno', 'ikona', 'pin', 'nastavenia', 'verzia', 'upravene'])
        && d.meno is string && d.meno.size() >= 1 && d.meno.size() <= 20
        && d.ikona in ['r1', 'r2', 'r3', 'r4', 'r5', 'r6']
        && d.pin is map && d.pin.keys().hasOnly(['sol', 'hash', 'iter'])
        && d.pin.sol is string && d.pin.sol.size() >= 8 && d.pin.sol.size() <= 32
        && d.pin.hash is string && d.pin.hash.size() >= 16 && d.pin.hash.size() <= 128
        && d.pin.iter is int && d.pin.iter >= 1000 && d.pin.iter <= 1000000
        && d.nastavenia is map && d.nastavenia.keys().hasOnly(['hnitie'])
        && (!('hnitie' in d.nastavenia) || (d.nastavenia.hnitie is map && d.nastavenia.hnitie.size() <= 8))
        && d.verzia is int && d.verzia >= 0 && d.verzia <= 1000
        && d.upravene == request.time;
    }
    match /rodiny/{uid}/rodic/{profil} {
      allow read, delete: if jeMoj(uid);
      allow create, update: if jeMoj(uid) && profil == 'profil' && platnyRodic(request.resource.data);
    }

    // Pokrok z verzie 5 (jedno dieťa na účet): appka ho pri prvom prihlásení prevedie na profil dieťaťa
    function platnyPokrok(d) {
      return d.keys().hasOnly(['meno', 'vek', 'body', 'done', 'fav', 'dni', 'upravene', 'verzia'])
        && d.meno is string && d.meno.size() <= 20
        && d.vek in ['mladsi', 'starsi']
        && d.body is int && d.body >= 0 && d.body <= 1000000
        && d.done is list && d.done.size() <= 500
        && d.fav is list && d.fav.size() <= 500
        && d.dni is list && d.dni.size() <= 400
        && d.verzia is int
        && d.upravene == request.time;
    }

    match /pokrok/{uid} {
      allow read, delete: if jeMoj(uid);
      allow create, update: if jeMoj(uid) && platnyPokrok(request.resource.data);
    }

    // ---- Priatelia (verzia 2.0) ----
    function prihlaseny() { return request.auth != null; }
    function cesta(p) { return /databases/$(database)/documents/profily/$(p); }
    // profil dieťaťa patrí prihlásenému rodičovi
    function majitel(p) { return prihlaseny() && exists(cesta(p)) && get(cesta(p)).data.rodina == request.auth.uid; }
    function pisanie(p) { return exists(cesta(p)) && get(cesta(p)).data.get('pisanie', false) == true; }
    function zapnuty(p) { return exists(cesta(p)) && get(cesta(p)).data.zapnute == true; }

    // Verejný profil dieťaťa pre priateľov: len meno, postavička a pokrok z hry (nikdy e-mail, vek ani fotka)
    function platnyProfil(d) {
      return d.keys().hasOnly(['meno', 'avatar', 'body', 'seria', 'temy', 'odznaky', 'posledne', 'tyzKey', 'tyzStart', 'kod', 'rodina', 'zapnute', 'upravene', 'pisanie'])
        && d.meno is string && d.meno.size() >= 1 && d.meno.size() <= 20
        && platnyAvatar(d.avatar)
        && d.body is int && d.body >= 0 && d.body <= 1000000
        && d.seria is int && d.seria >= 0 && d.seria <= 5000
        && d.temy is int && d.temy >= 0 && d.temy <= 1000
        && d.odznaky is int && d.odznaky >= 0 && d.odznaky <= 500
        && d.posledne is list && d.posledne.size() <= 5
        && d.tyzKey is string && d.tyzKey.size() <= 10
        && d.tyzStart is int && d.tyzStart >= 0 && d.tyzStart <= 1000000
        && d.kod is string && d.kod.size() <= 12 && d.kod.matches('^[A-Za-z0-9-]*$')
        && d.rodina == request.auth.uid && d.zapnute is bool && (!('pisanie' in d) || d.pisanie is bool)
        && d.upravene == request.time;
    }
    match /profily/{pid} {
      allow get: if prihlaseny();
      allow create: if prihlaseny() && pid.matches('^[a-z0-9]{6,32}$')
        && exists(/databases/$(database)/documents/rodiny/$(request.auth.uid)/deti/$(pid)) && platnyProfil(request.resource.data);
      allow update: if prihlaseny() && resource.data.rodina == request.auth.uid && platnyProfil(request.resource.data);
      allow delete: if prihlaseny() && resource.data.rodina == request.auth.uid;

      // žiadosť o priateľstvo od dieťaťa {od}; nikto nemôže deti hľadať, len zadať kód
      match /ziadosti/{od} {
        allow read: if majitel(pid) || (prihlaseny() && resource.data.rodina == request.auth.uid);
        allow create: if od != pid && majitel(od) && zapnuty(pid) && zapnuty(od)
          && request.resource.data.keys().hasOnly(['meno', 'avatar', 'rodina', 'kedy'])
          && request.resource.data.meno is string && request.resource.data.meno.size() >= 1 && request.resource.data.meno.size() <= 20
          && platnyAvatar(request.resource.data.avatar) && request.resource.data.rodina == request.auth.uid
          && request.resource.data.kedy == request.time
          && !exists(/databases/$(database)/documents/profily/$(pid)/priatelia/$(od));
        allow delete: if majitel(pid) || (prihlaseny() && resource.data.rodina == request.auth.uid);
      }
      // priateľ {fid}: zápis len pri prijatí žiadosti (oboma smermi naraz)
      match /priatelia/{fid} {
        allow read: if majitel(pid);
        allow create: if request.resource.data.keys().hasOnly(['kedy']) && request.resource.data.kedy == request.time
          && ((majitel(pid) && exists(/databases/$(database)/documents/profily/$(pid)/ziadosti/$(fid)))
            || (majitel(fid) && exists(/databases/$(database)/documents/profily/$(fid)/ziadosti/$(pid))));
        allow delete: if majitel(pid) || majitel(fid);
      }
    }

    // kód priateľa (napríklad SOVA-K7M2) → profil dieťaťa; dá sa len prečítať podľa presného kódu
    match /kody/{kod} {
      allow get: if prihlaseny();
      allow create: if prihlaseny() && kod.matches('^[A-Z]{4}-[A-Z0-9]{4}$')
        && request.resource.data.keys().hasOnly(['pid', 'rodina']) && request.resource.data.rodina == request.auth.uid
        && exists(/databases/$(database)/documents/rodiny/$(request.auth.uid)/deti/$(request.resource.data.pid));
      allow delete: if prihlaseny() && resource.data.rodina == request.auth.uid;
    }

    // správy medzi dvoma priateľmi: rozhovor {a_b} (a < b), nálepka, hotová veta alebo vlastný text (x, najviac 200 znakov) len keď ho rodič zapol oboma deťom
    function platnaSprava(d) {
      return d.keys().hasOnly(['od', 'k', 'n', 't', 'h', 'x', 'kedy']) && d.kedy == request.time
        // pochvala témou: id témy a počet hviezd (0 až 3)
        && (('x' in d && !('k' in d) && !('n' in d) && !('t' in d) && !('h' in d) && d.x is string && d.x.size() >= 1 && d.x.size() <= 200)
          || ('t' in d && !('x' in d) && !('k' in d) && !('n' in d) && d.t is string && d.t.matches('^[a-z0-9-]{2,30}$') && d.h is int && d.h >= 0 && d.h <= 3)
          || ('k' in d && !('x' in d) && !('n' in d) && !('t' in d) && !('h' in d) && d.k in ['ahoj', 'ako', 'super', 'grat', 'sisuper', 'tema', 'odznak', 'seria', 'sutaz', 'dobiehaj', 'ucit', 'dakujem', 'haha', 'noc', 'ano', 'nie'])
          || ('n' in d && !('x' in d) && !('k' in d) && !('t' in d) && !('h' in d) && d.n in ['sova', 'ohen', 'hviezda', 'srdce', 'pohar', 'raketa', 'duha', 'koruna', 'konfety', 'palec', 'smiech', 'diamant', 'blesk', 'mozog', 'jednorozec', 'kniha']));
    }
    match /rozhovory/{rid}/spravy/{sid} {
      allow read: if prihlaseny() && rid.split('_').size() == 2 && (majitel(rid.split('_')[0]) || majitel(rid.split('_')[1]));
      allow create: if prihlaseny() && rid.split('_').size() == 2 && rid.split('_')[0] < rid.split('_')[1]
        && request.resource.data.od in rid.split('_') && majitel(request.resource.data.od)
        && zapnuty(rid.split('_')[0]) && zapnuty(rid.split('_')[1])
        && exists(/databases/$(database)/documents/profily/$(rid.split('_')[0])/priatelia/$(rid.split('_')[1]))
        && exists(/databases/$(database)/documents/profily/$(rid.split('_')[1])/priatelia/$(rid.split('_')[0]))
        && platnaSprava(request.resource.data)
        // vlastný text (x) len keď rodič zapol voľné písanie oboma deťom; hotové vety a nálepky bez toho
        && (!('x' in request.resource.data) || (pisanie(rid.split('_')[0]) && pisanie(rid.split('_')[1])));
      // srdiečko: dá ho len ten, komu správa prišla, a zmení len pole r
      allow update: if prihlaseny() && rid.split('_').size() == 2
        && majitel(resource.data.od == rid.split('_')[0] ? rid.split('_')[1] : rid.split('_')[0])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])
        && (!('r' in request.resource.data) || request.resource.data.r == 'srdce');
    }
    // „Videné“: kedy si dieťa {pid} naposledy pozrelo rozhovor
    match /rozhovory/{rid}/citane/{pid} {
      allow read: if prihlaseny() && rid.split('_').size() == 2 && (majitel(rid.split('_')[0]) || majitel(rid.split('_')[1]));
      allow create, update: if prihlaseny() && rid.split('_').size() == 2 && pid in rid.split('_') && majitel(pid)
        && request.resource.data.keys().hasOnly(['kedy']) && request.resource.data.kedy == request.time;
    }

    match /{dokument=**} {
      allow read, write: if false;
    }
  }
}
