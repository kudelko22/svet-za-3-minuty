rules_version = '2';
// Svet za 3 minúty: každý prihlásený rodič vidí a mení len svoju rodinu.
service cloud.firestore {
  match /databases/{database}/documents {

    function jeMoj(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profil dieťaťa: meno, vek, postavička, pokrok a odznaky (od verzie 6; odznaky a zvieratko od verzie 8, kedy a chyby od verzie 11)
    function platneDieta(d) {
      return d.keys().hasOnly(['meno', 'vek', 'avatar', 'body', 'done', 'fav', 'dni', 'odznaky', 'kedy', 'chyby', 'poradie', 'verzia', 'upravene'])
        && d.meno is string && d.meno.size() >= 1 && d.meno.size() <= 20
        && d.vek in ['mladsi', 'starsi']
        && d.avatar is map
        && d.avatar.keys().hasOnly(['vlasy', 'farbaVlasov', 'koza', 'oci', 'usta', 'okuliare', 'tricko', 'vzor', 'doplnok', 'zvieratko', 'pozadie'])
        && (!('odznaky' in d) || (d.odznaky is list && d.odznaky.size() <= 100))
        && (!('kedy' in d) || (d.kedy is map && d.kedy.size() <= 500))
        && (!('chyby' in d) || (d.chyby is list && d.chyby.size() <= 60))
        && d.body is int && d.body >= 0 && d.body <= 1000000
        && d.done is list && d.done.size() <= 500
        && d.fav is list && d.fav.size() <= 500
        && d.dni is list && d.dni.size() <= 400
        && d.poradie is int && d.verzia is int
        && d.upravene == request.time;
    }

    match /rodiny/{uid}/deti/{dieta} {
      allow read, delete: if jeMoj(uid);
      allow create, update: if jeMoj(uid) && dieta.matches('^[a-z0-9]{6,32}$') && platneDieta(request.resource.data);
    }

    // Pokrok z verzie 5 (jedno dieťa na účet): appka ho pri prvom prihlásení prevedie na profil dieťaťa
    function platnyPokrok(d) {
      return d.keys().hasOnly(['meno', 'vek', 'body', 'done', 'fav', 'dni', 'upravene', 'verzia'])
        && d.meno is string && d.meno.size() <= 20
        && d.vek in ['mladsi', 'starsi']
        && d.body is int && d.body >= 0 && d.body <= 1000000
        && d.done is list && d.done.size() <= 500
        && d.fav is list && d.fav.size() <= 500
        && d.dni is list && d.dni.size() <= 400
        && d.verzia is int
        && d.upravene == request.time;
    }

    match /pokrok/{uid} {
      allow read, delete: if jeMoj(uid);
      allow create, update: if jeMoj(uid) && platnyPokrok(request.resource.data);
    }

    match /{dokument=**} {
      allow read, write: if false;
    }
  }
}
