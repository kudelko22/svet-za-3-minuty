rules_version = '2';
// Svet za 3 minúty: každý prihlásený rodič vidí a mení len svoj vlastný pokrok.
service cloud.firestore {
  match /databases/{database}/documents {

    function jeMoj(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function platnyPokrok(d) {
      return d.keys().hasOnly(['meno', 'vek', 'body', 'done', 'fav', 'dni', 'upravene', 'verzia'])
        && d.meno is string && d.meno.size() <= 20
        && d.vek in ['mladsi', 'starsi']
        && d.body is int && d.body >= 0 && d.body <= 1000000
        && d.done is list && d.done.size() <= 500
        && d.fav is list && d.fav.size() <= 500
        && d.dni is list && d.dni.size() <= 400
        && d.verzia is int
        && d.upravene == request.time;
    }

    match /pokrok/{uid} {
      allow read, delete: if jeMoj(uid);
      allow create, update: if jeMoj(uid) && platnyPokrok(request.resource.data);
    }

    match /{dokument=**} {
      allow read, write: if false;
    }
  }
}
