{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "README.md", "**/*.log", ".git/**", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": { "port": 9199 },
    "firestore": { "port": 8180 },
    "hosting": { "port": 5050 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Svet za 3 minúty",
        "supportEmail": "kudela.alexo@gmail.com",
        "authorizedRedirectUris": [
          "https://svet-za-3-minuty.firebaseapp.com/__/auth/handler",
          "https://svet-za-3-minuty.web.app/__/auth/handler"
        ]
      }
    }
  }
}
